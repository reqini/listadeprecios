PORT=3000
# --- Persistencia (elegí UNA de las dos opciones, o ninguna si es solo local) ---
# Opción A (GRATIS, recomendada): Supabase. Todo el estado (empresas, reglas,
# conversaciones, sesiones de WhatsApp vinculadas, archivos subidos y logins) se
# replica a Supabase y se restaura solo después de cada deploy/reinicio.
# Requiere: correr supabase/migrations/0003_whatsapp_bot_kv.sql en el proyecto, y la
# SERVICE key (Project Settings -> API keys -> service_role). NUNCA la anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Opción B (paga): disco persistente del host (ej: Render Disk ~USD 7/mes) montado
# en /data y DATA_DIR apuntando ahí.
# DATA_DIR=

# Credenciales del ADMINISTRADOR (no de una empresa puntual): solo sirven para crear
# y borrar empresas (entornos) desde /admin.html. Cada empresa tiene su propio
# usuario/clave, elegidos al crearla desde ese panel.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambiame-por-una-clave-segura

# Necesaria solo si activás "Respuestas con IA" en algún número.
# Conseguila en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-4-8). Para mucho volumen
# de mensajes y bajar costo, se puede usar un modelo más chico, ej: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# Necesarias solo si activás "Iniciar sesión con Google" (opcional). Se generan
# en https://console.cloud.google.com/apis/credentials (tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "URI de redireccionamiento autorizado" del cliente
# OAuth en Google Cloud. En producción, cambiar localhost por el dominio real.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
